# Copy to .env.local for local dev. On Vercel, set NEXT_PUBLIC_API_BASE in the
# project's Environment Variables instead.

# Local dev: the FastAPI server started by scripts/dev.ps1
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Production (Vercel): the Cloud Run service URL, e.g.
# NEXT_PUBLIC_API_BASE=https://sr-generator-api-xxxx-uc.a.run.app
