# What NOT to upload to Cloud Build when running `gcloud run deploy --source .`
# (the API image doesn't need the frontend, tests, or docs).
.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.coverage
htmlcov
apps/
tests/
docs/
build/
dist/
*.spec
storage/**
!storage/**/.gitkeep
models/band/**
models/singers/**
*.db
*.db-shm
*.db-wal
*.sqlite3
*.md
.env
.env.*
docker-compose.yml
