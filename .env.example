# Copy to .env and adjust. All values below are the native-Windows Stage 0 defaults.

# --- Database ---------------------------------------------------------------
# SQLite (default, no install needed). Switch to Postgres by changing this URL:
#   postgresql+psycopg://user:pass@localhost:5432/sr_generator
SR_DATABASE_URL=sqlite:///./storage/dev.db

# --- Job queue -------------------------------------------------------------
# inline  = run jobs in a background thread, no Redis required (Stage 0 default)
# rq      = Redis-backed RQ workers (needs Redis / Memurai running)
SR_QUEUE_BACKEND=inline
SR_REDIS_URL=redis://localhost:6379/0

# --- Storage --------------------------------------------------------------
# local filesystem root for all audio assets; abstracted for S3 later
SR_STORAGE_ROOT=./storage

# --- Providers -----------------------------------------------------------
# mastering / transcription are still mock (later stages).
SR_MASTERING_PROVIDER=mock
SR_TRANSCRIPTION_PROVIDER=mock

# Music: local_synth = deterministic NumPy instrumental engine + adapters (default)
#        http        = a real generative-music service at SR_MUSIC_HTTP_URL
#                      (POST /generate -> WAV, POST /train-adapter -> JSON spec)
#        mock        = near-silent stereo noise (fast tests)
SR_MUSIC_PROVIDER=local_synth
SR_MUSIC_HTTP_URL=

# Reference-song analysis: local_mir = real NumPy MIR (default) / http / mock
SR_ANALYSIS_PROVIDER=local_mir
SR_ANALYSIS_HTTP_URL=

# Stem separation: center_split = real center-channel DSP (default)
#                  http         = a Demucs-class service at SR_STEM_HTTP_URL
#                  mock         = trivial split (fast tests)
SR_STEM_PROVIDER=center_split
SR_STEM_HTTP_URL=

# Voice: local_dsp = real dependency-free guide->singer conversion (default)
#        http      = call a GPU voice-model service at SR_VOICE_HTTP_URL
#        mock      = cheap detune only (fast tests)
SR_VOICE_PROVIDER=local_dsp
SR_VOICE_HTTP_URL=

# --- Misc --------------------------------------------------------------
SR_LOG_LEVEL=INFO
# Global fallback seed when a request/job does not pin one
SR_DEFAULT_SEED=1337
SR_API_CORS_ORIGINS=http://localhost:3000
